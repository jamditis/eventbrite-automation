# Eventbrite Automation - Environment Variables
# Copy this file to .env in the project root and fill in your values
# cp deploy/.env.example .env

# Airtable credentials
# Get your PAT from: https://airtable.com/create/tokens
AIRTABLE_PAT=pat_xxxxxxxxxxxxxxxxxx
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_ID=tblXXXXXXXXXXXXXX

# Google Gemini API key
# Get from: https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza_xxxxxxxxxxxxxxxxxxxxxxxx

# Eventbrite API token
# Get from: https://www.eventbrite.com/platform/api-keys
EVENTBRITE_PRIVATE_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional: Webhook authentication secret.
# NOTE: setting the secret alone does nothing — verification only happens
# when WEBHOOK_REQUIRE_AUTH=true is ALSO set, and the Airtable automation
# script must send the secret in its JSON body ({"secret": "..."}).
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# WEBHOOK_SECRET=your_random_secret_here
# WEBHOOK_REQUIRE_AUTH=true

# Optional: Status value set on a record when processing fails.
# Must be an existing option in the Airtable Status field.
# ERROR_STATUS=Needs review
