[Unit]
Description=Eventbrite attendee digest cron
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=jamditis
Group=jamditis
WorkingDirectory=/home/jamditis/projects/eventbrite-attendee-digest
EnvironmentFile=/home/jamditis/projects/eventbrite-attendee-digest/.env
Environment=PYTHONPATH=/home/jamditis/projects/eventbrite-attendee-digest/src
ExecStart=/usr/bin/timeout --foreground 600 /home/jamditis/projects/eventbrite-attendee-digest/.venv/bin/python -m digest.cron
