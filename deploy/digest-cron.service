[Unit]
Description=Eventbrite attendee digest cron
After=network-online.target
Wants=network-online.target
# Any non-zero exit (run-level crash or per-event failure — see
# digest/cron.py main() exit codes) emails the standing staff list so a
# broken tick never fails silently.
OnFailure=digest-failure-alert.service

[Service]
Type=oneshot
User=jamditis
Group=jamditis
WorkingDirectory=/home/jamditis/projects/eventbrite-automation
EnvironmentFile=/home/jamditis/projects/eventbrite-automation/.env.digest
ExecStart=/usr/bin/timeout --foreground 600 /home/jamditis/projects/eventbrite-automation/venv/bin/python -m digest.cron
