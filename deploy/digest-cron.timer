# Eventbrite attendee digest -- schedule.
#
# Ticks once daily. The digest is a daily email per event, so one tick a day
# is enough; the previous *:0/30 schedule was 48 runs/day for a single send.
#
# Consequence of a once-a-day tick: a row's `Send time (ET)` is only a
# fire-no-earlier-than floor -- should_send_today() requires now_et >=
# send_time. The tick lands at 07:00 ET, so an event whose `Send time (ET)`
# is later than 07:00 never clears the gate and its digest never sends. Keep
# per-event send times <= 07:00, or move OnCalendar later to cover them.
#
# Retry behavior also changes: a transient per-event failure (EB 429, SMTP
# error) is retried on the NEXT day's tick, not 30 minutes later.
[Unit]
Description=Run eventbrite digest cron once daily at 07:00 ET

[Timer]
OnCalendar=*-*-* 07:00:00
Persistent=true
Unit=digest-cron.service

[Install]
WantedBy=timers.target
