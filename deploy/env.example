# Environment file template for the digest cron.
#
# IMPORTANT: this file is loaded by systemd via EnvironmentFile=. systemd's
# parser does NOT support inline comments (`KEY=value # note`) — the comment
# becomes part of the value. Comments must be on their OWN line, starting
# with #. No quoting needed for typical values; if your secret contains a
# literal `#`, wrap it in single quotes (`KEY='secret#with#hash'`).
#
# Copy this file: `cp deploy/env.example .env.digest` and fill in below. Then
# `chmod 600 .env.digest` so credentials are readable only by your user.
#
# The digest deliberately uses `.env.digest`, NOT `.env` — the repo's `.env`
# belongs to the webhook server and sets a different AIRTABLE_BASE_ID.

# Eventbrite
# Source: pass show claude/api/eventbrite/eventbrite-token
EVENTBRITE_PRIVATE_TOKEN=

# Airtable
# Source: PAT scoped to EventDigests base
AIRTABLE_PAT=
# Source: the base ID (e.g., appXXXXXXXXXXXXXX)
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Events

# Dashboard CRM (houseofjawn local API)
DASHBOARD_API_BASE=http://localhost:8081/api
# Source: pass show claude/tokens/dashboard-api
DASHBOARD_API_KEY=

# SMTP — fill in the sender Gmail account for production (CCM uses the
# njnewscommons account; check pass for credentials).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
# Source: pass show gmail-app-password
SMTP_PASSWORD=
SMTP_FROM_NAME=Center for Cooperative Media
SMTP_FROM_EMAIL=

# Always-BCC: Joe + Cassandra on every outgoing digest
BCC_ALWAYS=jamditis@gmail.com,etiennec@montclair.edu

# LLM CLI binaries (override only if non-default install paths)
GEMINI_BIN=gemini
CODEX_BIN=codex
CODEX_MODEL=gpt-5.4-low

# Optional: override the email_ledger module path.
# Default: ~/projects/houseofjawn-bot/scheduler. If the module is unavailable
# at runtime, the cron logs a warning and runs without the cross-session dup
# safety net (Airtable last_digest_sent_at remains the primary dup defense).
# DIGEST_LEDGER_PATH=/path/to/email_ledger/dir
