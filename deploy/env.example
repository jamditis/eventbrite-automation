# Eventbrite
EVENTBRITE_PRIVATE_TOKEN=         # `pass show claude/api/eventbrite/eventbrite-token`

# Airtable
AIRTABLE_PAT=                      # PAT scoped to EventDigests base
AIRTABLE_BASE_ID=                  # the base ID (e.g., appXXXXXXXXXXXXXX)
AIRTABLE_TABLE_NAME=Events

# Dashboard CRM
DASHBOARD_API_BASE=http://localhost:8081/api
DASHBOARD_API_KEY=                 # `pass show claude/tokens/dashboard-api`

# SMTP (njnewscommons)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=njnewscommons@gmail.com
SMTP_PASSWORD=                     # `pass show gmail-app-password`
SMTP_FROM_NAME=Center for Cooperative Media
SMTP_FROM_EMAIL=njnewscommons@gmail.com

# Always-BCC
BCC_ALWAYS=jamditis@gmail.com,etiennec@montclair.edu

# LLM CLI binaries (override only if needed)
GEMINI_BIN=gemini
CODEX_BIN=codex
CODEX_MODEL=gpt-5.4-low

# Telegram alerts on catastrophic cron failure (optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
