[Unit]
Description=Eventbrite Automation Webhook Server
After=network.target

[Service]
Type=simple
User=pi
Group=pi
WorkingDirectory=/home/pi/eventbrite-automation
Environment="PATH=/home/pi/eventbrite-automation/venv/bin"
ExecStart=/home/pi/eventbrite-automation/venv/bin/gunicorn webhook_server:app -b 0.0.0.0:5000 --workers 2 --timeout 120
Restart=always
RestartSec=10

# Logging
StandardOutput=append:/var/log/eventbrite-automation/webhook.log
StandardError=append:/var/log/eventbrite-automation/webhook-error.log

[Install]
WantedBy=multi-user.target
