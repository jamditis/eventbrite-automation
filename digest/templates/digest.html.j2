<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ subject }}</title>
</head>
<body style="margin: 0; padding: 0; background: #f6f7fa; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;">
  <div style="max-width: 600px; margin: 0 auto; padding: 24px; background: #fff; color: #1a1a1a;">

    {% if logo_url %}
    <div style="margin-bottom: 16px;">
      <img src="{{ logo_url }}" alt="Center for Cooperative Media" width="120" style="display: block;">
    </div>
    {% endif %}

    <h1 style="font-size: 22px; line-height: 1.3; margin: 0 0 4px 0;">{{ event_title }}</h1>
    <p style="font-size: 14px; color: #555; margin: 0 0 20px 0;">{{ event_when }}{% if event_location %} · {{ event_location }}{% endif %}</p>

    <p style="font-size: 15px; line-height: 1.5; margin: 0 0 18px 0;">
      Here's a quick snapshot of who has registered for your session. <strong>{{ total_count }}
      {{ 'person has' if total_count == 1 else 'people have' }} signed up</strong>{% if not is_initial and new_count %}, including {{ new_count }} new since the last update{% endif %}.
      The table below gives you an at-a-glance look at each attendee{% if columns %} and the topics they want you to cover{% endif %}{% if sheet_url %} &mdash; open the full attendee sheet for everyone's complete responses{% endif %}.
    </p>

    {% if sheet_url %}
    <div style="margin: 0 0 22px 0;">
      <a href="{{ sheet_url }}" style="display: inline-block; background: #0066cc; color: #fff; text-decoration: none; font-size: 15px; font-weight: 600; padding: 11px 20px; border-radius: 6px;">View full attendee sheet &rarr;</a>
    </div>
    {% endif %}

    <table role="presentation" cellpadding="0" cellspacing="0" width="100%" style="border-collapse: collapse; font-size: 14px; margin: 0 0 8px 0;">
      <thead>
        <tr style="background: #f0f2f5; text-align: left;">
          <th style="padding: 8px 10px; border-bottom: 2px solid #dde1e6; font-weight: 600;">Attendee</th>
          {% for col in columns %}
          <th style="padding: 8px 10px; border-bottom: 2px solid #dde1e6; font-weight: 600;">{{ col.label | truncate(42, true, '…') }}</th>
          {% endfor %}
        </tr>
      </thead>
      <tbody>
        {% for row in rows %}
        <tr style="background: {{ '#ffffff' if loop.index0 % 2 == 0 else '#fafbfc' }};">
          <td style="padding: 8px 10px; border-bottom: 1px solid #eef0f3; vertical-align: top; white-space: nowrap;">
            {{ row.name }}{% if row.is_new and not is_initial %} <span style="font-size: 11px; color: #0066cc; font-weight: 600;">&middot; new</span>{% endif %}
          </td>
          {% for col in columns %}
          <td style="padding: 8px 10px; border-bottom: 1px solid #eef0f3; vertical-align: top; color: #444;">{{ (row.answers.get(col.key) or '—') | truncate(140, true, '…') }}</td>
          {% endfor %}
        </tr>
        {% endfor %}
      </tbody>
    </table>

    <hr style="border: none; border-top: 1px solid #ddd; margin: 28px 0 16px 0;">

    <p style="font-size: 13px; color: #666; margin: 0 0 8px 0;">
      Questions about this briefing? Just reply to this email.
    </p>
    <p style="font-size: 12px; color: #999; margin: 0;">
      Sent by the Center for Cooperative Media · njnewscommons@gmail.com
    </p>

  </div>
</body>
</html>
